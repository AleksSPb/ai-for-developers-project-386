import "@typespec/http";
import "@typespec/rest";
import "@typespec/openapi";

using TypeSpec.Http;
using TypeSpec.Rest;
using TypeSpec.OpenAPI;

/**
 * Контракт сервиса бронирования звонков.
 *
 * Источник правды — этот файл. Сгенерированный код воспроизводится из
 * `openapi.yaml` и не коммитится.
 *
 * Что контракт НЕ описывает: расписание. Слоты считает клиент из окон
 * приёма и длительности Типа события, которые приходят здесь. Контракт
 * описывает форму данных, а не логику их вычисления.
 *
 * Чего в контракте нет по умыслу: арифметики Слотов на сервере, сущности
 * «Событие» (существует только Тип события), маршрутов `/admin` и удаления
 * Типа события. Владельца как сущности тоже нет — см. docs/adr/0004.
 */
@service(#{ title: "Календарь — запись на звонок" })
@info(#{ version: "3" })
namespace CalendarApi;

/**
 * Отрезок времени в Броне, Слоте или окне приёма.
 *
 * Это настоящие моменты, а не минуты от полуночи, поэтому такой отрезок
 * физически не может выглядеть как «начало позже конца»: момент окончания
 * всегда позже момента начала. Дата дня отсюда выводится, а отдельно не
 * хранится.
 *
 * Каждый момент несёт собственное смещение, поэтому переход на летнее время
 * не требует ничего, а ночное окно выразимо: окно приёма может перешагнуть
 * полночь.
 */
model TimeRange {
  /** Начало, с точностью до секунд. */
  @encode("rfc3339")
  start: utcDateTime;

  /** Конец, с точностью до секунд. Всегда позже `start`. */
  @encode("rfc3339")
  end: utcDateTime;
}

/**
 * Пределы текстов Типа события.
 *
 * Границы живут **в контракте**, а не только в форме. Идентификатора и длительности
 * не сменить, удаления Типа нет, а название попадает в гостевую ссылку — поэтому
 * длинное значение, однажды сохранённое, пришлось бы исправлять заведением нового
 * Типа и раздачей новых ссылок. Проверка обязана быть там, где текст ещё можно не
 * пустить.
 *
 * Три предела и все разные. Идентификатор — самый жёсткий: он попадает прямо в
 * адрес, из-за чего ломается и ссылка, и её отправка в чат. Название — короткая
 * метка, описание — текст, и Владелец пишет их по разным поводам.
 *
 * Длина считается в символах, а не в байтах: кириллица и латиница занимают в адресе
 * разное число байт, и предел в байтах был бы для них разным.
 */
const ID_MAX = 40;
const NAME_MAX = 100;
const DESCRIPTION_MAX = 600;

/**
 * Нижняя граница идентификатора.
 *
 * Ссылка гостя — `/book/ab` — читается хуже `/book/consultation` или хотя бы
 * `/book/abc`, а однобуквенные идентификаторы кончаются первыми же: завести
 * второй Тип, назвав его `b`, Владелец не сможет.
 *
 * Три — не техническое ограничение, а договорённость о том, как выглядит адрес.
 * Технически `/book/a` работал бы ничуть не хуже.
 *
 * У названия и описания нижней границы выше единицы нет: они не попадают в адрес
 * и пишутся свободно.
 */
const ID_MIN = 3;

/**
 * Тип события в списке для выбора и в списке Владельца.
 *
 * Идентификатор приходит с сервера, поэтому на клиенте это строка, а не
 * значение закрытого набора: валидация уходит в рантайм.
 *
 * Идентификатор пишет сам Владелец и он неизменен после создания, потому что
 * попадает прямо в гостевую ссылку.
 */
model EventTypeSummary {
  /**
   * Идентификатор Типа события, из которого строится адрес записи.
   * Строчные латинские буквы, цифры и дефис. Присваивает Владелец.
   */
  @minLength(ID_MIN)
  @maxLength(ID_MAX)
  @pattern("^[a-z0-9-]+$")
  id: string;

  /** Название для показа: Владельцу в списке, Гостю на странице выбора. */
  @minLength(1)
  @maxLength(NAME_MAX)
  name: string;

  /**
   * Что это за событие, для показа Гостю под названием.
   *
   * Названия не уникальны, поэтому описание — единственное, чем два Типа с
   * одинаковым названием различаются для Гостя. Поле обязательное.
   *
   * Предел самый просторный из трёх, и обрезать его нельзя: обрезанное описание
   * сделало бы два одинаково названных Типа неразличимыми, и Гость не увидел бы
   * почему.
   */
  @minLength(1)
  @maxLength(DESCRIPTION_MAX)
  description: string;

  /**
   * Длительность Слота в минутах, определяется этим Типом.
   *
   * Кратна 15 и не меньше 15. Верхней границы нет: она означала бы проверку
   * против Горизонта записи, а Горизонт сам выводится из опубликованных окон.
   * Тип длиннее окна допустим — такой день помечается как «нет слотов под ваш
   * тип».
   *
   * Машиночитаемого ограничения кратности в OpenAPI 3.0 нет, поэтому здесь
   * оно записано текстом и проверяется сервером.
   */
  @minValue(15)
  durationMinutes: int32;

  /**
   * Сколько Бронь заведено на этот Тип, за всё время включая прошедшие.
   *
   * Считает сервер: на странице Типов списка Броней нет, и считать не из чего.
   * Ответ на вопрос «а работает ли это»; «сколько впереди» — вопрос страницы
   * встреч.
   */
  @minValue(0)
  bookingCount: int32;
}

/** Список Типов событий, доступных для записи. */
model EventTypeList {
  /** Типы, доступные для записи. Пустой список — запись невозможна. */
  types: EventTypeSummary[];
}

/** Запрос на создание Типа события. Идентификатор задаёт Владелец. */
model CreateEventTypeRequest {
  /**
   * Идентификатор Типа события, из которого строится гостевой адрес записи.
   * Строчные латинские буквы, цифры и дефис.
   */
  @minLength(ID_MIN)
  @maxLength(ID_MAX)
  @pattern("^[a-z0-9-]+$")
  id: string;

  /** Название Типа события. */
  @minLength(1)
  @maxLength(NAME_MAX)
  name: string;

  /** Что это за событие. */
  @minLength(1)
  @maxLength(DESCRIPTION_MAX)
  description: string;

  /**
   * Длительность Слота в минутах. Кратна 15 и не меньше 15.
   * Задаётся один раз и больше не меняется: см. docs/adr/0005.
   */
  @minValue(15)
  durationMinutes: int32;
}

/**
 * Запрос на переименование Типа события.
 *
 * Идентификатора здесь нет: он неизменен после создания, и менять его нельзя.
 */
model UpdateEventTypeRequest {
  /** Новое название Типа события. */
  @minLength(1)
  @maxLength(NAME_MAX)
  name: string;

  /** Новое описание Типа события. */
  @minLength(1)
  @maxLength(DESCRIPTION_MAX)
  description: string;
}

/** Окно приёма, в котором Владелец принимает в этом Календаре. */
model AvailabilityWindowList {
  /**
   * Окна приёма, плоским списком и в порядке, который выдаёт сервер.
   *
   * Окна общие для всего Календаря, а не отдельные у Типов событий.
   *
   * Порядок устойчив: два запроса подряд дают один и тот же порядок, пока
   * данные не изменились. Иначе два Типа с одинаковым названием прыгали бы
   * по списку, и Гость не мог бы ни на что опереться.
   */
  windows: TimeRange[];
}

/**
 * Бронь — единственное, что хранится.
 *
 * Идентификатор и время создания присваивает сервер, а Тип события приходит
 * от Гостя при записи. Длительность интервала сверяется с длительностью
 * Типа при создании, поэтому Бронь не может не соответствовать своему Типу.
 */
model Booking {
  /** Идентификатор, присваивает сервер. */
  @minLength(1)
  id: string;

  /** Идентификатор Типа события, под который Гость забронировал. */
  @minLength(1)
  eventTypeId: string;

  /** Занятый отрезок времени целиком. */
  timeRange: TimeRange;

  /** Имя, которое Гость назвал сам. */
  @minLength(1)
  guestName: string;

  /** Почта, которую Гость назвал сам. */
  @format("email")
  guestEmail: string;

  /** Когда создана Бронь, по часам сервера. */
  @encode("rfc3339")
  createdAt: utcDateTime;
}

/** Запрос на запись. Идентификатор и время создания присваивает сервер. */
model CreateBookingRequest {
  /** Тип события, выбранный на странице выбора. */
  @minLength(1)
  eventTypeId: string;

  /** Выбранный Слот, который Гость занимает целиком. */
  timeRange: TimeRange;

  /** Имя Гостя. */
  @minLength(1)
  guestName: string;

  /** Почта Гостя. */
  @format("email")
  guestEmail: string;
}

/** Слот занят другим Гостем. Возможен и при гонке — проигрывает второй. */
@error
model SlotTakenError {
  code: "slot_taken";
  message: string;
}

/**
 * Такого Слота нет: день вне Горизонта записи, либо Бронь сгорела,
 * а подтверждение пришло позже.
 */
@error
model SlotNotFoundError {
  code: "slot_not_found";
  message: string;
}

/** Типа события, который был в ссылке, на сервере больше нет. */
@error
model EventTypeNotFoundError {
  code: "event_type_not_found";
  message: string;
}

/**
 * Такой Тип события уже есть.
 *
 * Отдельный код от `validation_failed`: «это значение уже занято» и «это
 * значение негодно» — разные причины.
 */
@error
model EventTypeExistsError {
  code: "event_type_exists";
  message: string;
}

/**
 * Проверка данных не прошла.
 *
 * Возвращает **все** негодные поля сразу, а не по одному, чтобы форма
 * подсвечивала всё негодное за один проход.
 */
@error
model ValidationError {
  code: "validation_failed";
  message: string;

  /**
   * Поля, в которых ошибка: `["id", "description"]`.
   *
   * Их несколько, потому что форма должна подсветить всё сразу.
   */
  fields: string[];
}

/**
 * Время, по которому записаться нельзя.
 *
 * Гость не соревнуется с кем-то — он прислал время, которого нет. Это не
 * `slot_taken`: здесь про другое.
 */
@error
model TimeNotBookableError {
  code: "time_not_bookable";
  message: string;

  /** Поле, в котором ошибка. Всегда `timeRange`. */
  @minLength(1)
  field: string;
}

/** Сервер не отвечает. Повтор инициирует сам Гость. */
@error
model ServiceUnavailableError {
  code: "service_unavailable";
  message: string;
}

@error
model Error409SlotTaken {
  @statusCode
  statusCode: 409;
  @body
  body: SlotTakenError;
}

@error
model Error409TypeExists {
  @statusCode
  statusCode: 409;
  @body
  body: EventTypeExistsError;
}

@error
model Error404Slot {
  @statusCode
  statusCode: 404;
  @body
  body: SlotNotFoundError;
}

@error
model Error404Type {
  @statusCode
  statusCode: 404;
  @body
  body: EventTypeNotFoundError;
}

@error
model Error422Validation {
  @statusCode
  statusCode: 422;
  @body
  body: ValidationError;
}

/** Отказ по времени — только при записи: у операций Типов такого поля нет. */
@error
model Error422Time {
  @statusCode
  statusCode: 422;
  @body
  body: TimeNotBookableError;
}

@error
model Error503Unavailable {
  @statusCode
  statusCode: 503;
  @body
  body: ServiceUnavailableError;
}

model BookingCreated {
  @statusCode
  statusCode: 201;
  @body
  body: Booking;
}

model EventTypeCreated {
  @statusCode
  statusCode: 201;
  @body
  body: EventTypeSummary;
}

/** Типы событий: чтение списка и создание. */
@route("/event-types")
@tag("Типы событий")
interface EventTypes {
  /**
   * Типы, доступные для записи, со счётчиком Бронь.
   *
   * Одна операция отдаёт и список для гостевого выбора, и список для
   * Владельца: различаются они тем, что рисует клиент, а не тем, что
   * приезжает по сети.
   *
   * Пустой список означает, что запись невозможна.
   */
  @get
  listEventTypes(): EventTypeList | Error503Unavailable;

  /**
   * Создать Тип события.
   *
   * Владельца как сущности нет: операция открыта каждому, кто её вызовет.
   *
   * **Идемпотентна по содержимому.** Если приходит запрос, совпадающий со
   * всем, что уже заведено, возвращается успех с этим Типом. Иначе Владелец,
   * чья первая попытка прошла, а ответ потерялся, увидел бы отказ при
   * существующем Типе и решил бы, что создать не удалось.
   *
   * Ключ идемпотентности — набор всех полей, поэтому **любая правка Типа его
   * меняет сама собой**: повтор исходного запроса после переименования
   * вернёт `409`, потому что запрос больше не совпадает с тем, что лежит.
   */
  @post
  createEventType(
    /** Данные Типа события. */
    @body
    request: CreateEventTypeRequest,
  ): EventTypeCreated | Error409TypeExists | Error422Validation | Error503Unavailable;
}

/** Чтение и переименование Типа события. */
@route("/event-types")
@tag("Типы событий")
interface EventTypeById {
  /**
   * Прочитать один Тип события по идентификатору.
   *
   * Отдаёт ровно ту же `EventTypeSummary`, что и список, и то же, что отдаёт
   * переименование: у Типа не должно быть двух представлений, иначе расхождение
   * обнаружилось бы поздно, на данных.
   *
   * **Зовёт только гостевая страница записи**, у которой идентификатор Типа
   * известен из адреса, а списка у неё нет вовсе. Страница выбора Типов и
   * раздел Владельца берут всё из списка — ради одного названного Типа тянуть
   * весь список работа без пользы.
   *
   * **`404` сообщает о факте, а не придумывает сообщение:** гость видит
   * страницу выбора Типов. Того же кода на `POST /bookings` это не отменяет:
   * там он означает, что Тип исчез между открытием страницы и подтверждением.
   */
  @get
  getEventType(
    /** Идентификатор Типа события, неизменный после создания. */
    @path
    id: string,
  ): EventTypeSummary | Error404Type | Error503Unavailable;

  /**
   * Переименовать Тип события: название и описание.
   *
   * Идентификатор и длительность здесь не меняются. Длительность задаётся
   * один раз и больше не трогается — см. docs/adr/0005.
   *
   * Удаления нет и не объявляется: Тип, созданный однажды, живёт всегда, а
   * существующие Брони не могут осиротеть.
   */
  @patch(#{ implicitOptionality: false })
  updateEventType(
    /** Идентификатор Типа события, неизменный после создания. */
    @path
    id: string,

    /** Новое название и описание. */
    @body
    request: UpdateEventTypeRequest,
  ): EventTypeSummary | Error404Type | Error422Validation | Error503Unavailable;
}

/** Окна приёма. */
@route("/windows")
@tag("Расписание")
interface Availability {
  /**
   * Окна приёма, по которым строится календарь.
   *
   * Окна общие для Календаря и выражены моментами, а не суточным шаблоном:
   * дня без окна не бывает, а в одном дне окон может быть несколько.
   *
   * **Начало живого окна округляется вверх до ближайшего целого часа** по
   * зоне начала окна, конец не трогается. Окно `10:00–20:00` при запросе в
   * `13:37` приходит как `14:00–20:00`. Если после обрезки окно короче
   * длительности Типа события, оно не возвращается вовсе.
   *
   * Окно в прошлом — это окно, которое **целиком закончилось**. Окно, конец
   * которого в будущем, возвращается целиком, а прошедшие Слоты клиент
   * отсекает по правилу «Слот, который начался, не свободен».
   *
   * Окно попадает в ответ **по дате начала**: окно с началом
   * 30 июня и концом 2 июля приходит и в ответ за июнь, и в ответ за июль.
   *
   * **Срок, на который сервер выдаёт окна вперёд, решает сервер.** Параметра
   * диапазона в запросе нет: правую границу календаря задаёт последнее окно
   * в ответе.
   */
  @get
  getWindows(): AvailabilityWindowList | Error503Unavailable;
}

/** Брони Гостя. */
@route("/bookings")
@tag("Брони")
interface Bookings {
  /**
   * Все Брони, видимые Гостю.
   *
   * Имена и почты в ответе есть, а гостевая страница их не рисует: без
   * авторизации разница между «скрыто в интерфейсе» и «не отдаётся вовсе»
   * равна нулю — вызовут всё равно.
   *
   * Клиент читает список при загрузке и после каждой попытки записи —
   * успешной и нет. Без перечитывания клиентская проверка конфликта
   * сравнивает с устаревшим снимком и пропускает дубль.
   */
  @get
  listBookings(): Booking[] | Error503Unavailable;

  /**
   * Записать Гостя на Слот.
   *
   * Идемпотентно по содержимому: если такая Бронь уже есть, возвращается
   * успех с ней.
   *
   * Перед вставкой проверяется ровно три вещи: начало не в прошлом,
   * длительность равна длительности Типа события, интервал целиком внутри
   * окна приёма. Горизонт записи не проверяется — окон в прошлом и за
   * горизонтом не существует.
   *
   * Начало интервала **не привязано к сетке Слотов**: сервер не знает
   * правила «начало окна плюс кратное длительности». Поэтому интервал может
   * быть сдвинут относительно сетки, которую показывал клиент.
   */
  @post
  createBooking(
    /** Данные записи. Слот занимается целиком. */
    @body
    request: CreateBookingRequest,
  ): BookingCreated
    | Error409SlotTaken
    | Error404Slot
    | Error404Type
    | Error422Validation
    | Error422Time
    | Error503Unavailable;
}
