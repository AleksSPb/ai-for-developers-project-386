# Образец локального окружения. Скопируйте в `.env` и правьте под себя:
#
#   cp .env.example .env
#
# `.env` не коммитится (см. .gitignore). Все значения ниже — умолчания,
# поэтому compose поднимается и без этой копии.

# --- База данных ---

POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_PORT=5432

# --- Сервер ---

SERVER_PORT=8080

# --- Миграции ---
#
# Пусто (по умолчанию) — Liquibase выполняет все changeset'ы, включая сид окон.
# Значение `!seed` — режим без сида: схема создаётся, окна не заводятся.
#
# Второй путь — профиль `no-seed` при запуске вне Docker:
#   mvn spring-boot:run -Dspring-boot.run.profiles=no-seed
LIQUIBASE_CONTEXTS=
